# Copy to backend/.env for local dev. Never commit .env.
GOOGLE_CLOUD_PROJECT=cartpilot-511717
GOOGLE_CLOUD_LOCATION=asia-south1
# Local dev: use an AI Studio key. Cloud Run: GOOGLE_GENAI_USE_VERTEXAI=TRUE and no key.
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
MAX_ORDER_INR=5000
ALLOWED_ORIGINS=http://localhost:5173
# Skip Firebase token checks locally (requests act as "dev-user"). Never on Cloud Run.
AUTH_DISABLED=false
